# =========================================================
# MLB PREDICTION SYSTEM - ENVIRONMENT VARIABLES
# =========================================================

# ---------------------------------------------------------
# 1. BACKEND ENVIRONMENT VARIABLES (Render.com)
# ---------------------------------------------------------
# Port for the Express server (Render automatically sets this)
PORT=3001

# MLB Stats API Base Endpoint (if you use custom proxy or mirror)
MLB_API_BASE_URL=https://statsapi.mlb.com/api/v1

# Optional: API Secret or Custom Key for rate-limiting / security
API_SECRET_KEY=

# ---------------------------------------------------------
# 2. FRONTEND ENVIRONMENT VARIABLES (Vercel)
# ---------------------------------------------------------
# The Render backend URL where the C++ engine runs (e.g. https://mlb-prediction-backend.onrender.com)
VITE_API_URL=https://mlb-prediction-backend.onrender.com

# MLB Data API endpoint for live rosters, stats & standings
VITE_MLB_API_URL=https://statsapi.mlb.com/api/v1

# Player Headshot CDN URL
VITE_MLB_HEADSHOT_URL=https://img.mlbstatic.com/mlb-photos/image/upload/d_people:generic:headshot:67:current.png/w_213,q_auto:best/v1/people
